
# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_PATH=./database/isp_database.db

# MCP Server Configuration
# Using stdio (local) connections by default
MCP_CONNECTION_TYPE=stdio

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# PII redaction in logs (customer phone numbers).
#   true  (default) — phones masked, keeping last 4 digits: +37060012345 -> ***2345
#   false           — full numbers in logs for local test traceability
# Keep this true (or unset) in any deployed environment.
REDACT_PII=true
