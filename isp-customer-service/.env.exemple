
# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_PATH=./database/isp_database.db

# MCP Server Configuration
# Using stdio (local) connections by default
MCP_CONNECTION_TYPE=stdio

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# PII redaction in logs (customer phone numbers).
#   true  (default) — phones masked, keeping last 4 digits: +37060012345 -> ***2345
#   false           — full numbers in logs for local test traceability
# Keep this true (or unset) in any deployed environment.
REDACT_PII=true

# Main LLM and its fallback (services/llm/client.py, endpoints.py).
#   scaleway/<id>  Scaleway Generative APIs (EU) — key SCW_SECRET_KEY
#   local/<id>     own OpenAI-compatible server (Ollama / vLLM) — LOCAL_LLM_BASE_URL
#   gpt-4o-mini …  OpenAI — key OPENAI_API_KEY
# The fallback answers when the main model fails (down, timeout, invalid JSON);
# every hand-over is written to logs/ops/ops.log.
LLM_MODEL=scaleway/gemma-4-26b-a4b-it
LLM_FALLBACK_MODEL=gpt-4o-mini
SCW_SECRET_KEY=your-scaleway-secret-key
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LLM_PRIMARY_TIMEOUT_S=8        # main model's timeout when a fallback exists
# LLM_REASONING_EFFORT=none      # open models must not "think" on a call; empty = don't send
