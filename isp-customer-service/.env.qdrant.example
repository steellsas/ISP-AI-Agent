# Žinių indeksas Qdrant'e (RAG planas, E2). Nukopijuok šias eilutes į `.env` ir sugeneruok raktus.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Paleidimas:  docker compose up -d qdrant
# Indeksavimas: uv run python chatbot_core/src/rag/scripts/index_qdrant.py --rebuild
# Būklė:       uv run python chatbot_core/src/rag/scripts/index_qdrant.py --status

# NE `localhost`. Išmatuota (Windows, 2026-09-24): per `localhost` viena užklausa užtrunka 2056 ms,
# per `127.0.0.1` — 13 ms. `localhost` pirma bando IPv6 `::1`, kur portas neatidarytas, ir laukia.
QDRANT_URL=http://127.0.0.1:6343

# Du raktai, ne vienas. Agentas gauna TIK skaitymo raktą, tad net jei per LLM kelią kas nors bandytų
# rašyti į žinių bazę, techniškai neturi kuo. (Patikrinta: su skaitymo raktu POST -> 403, be rakto -> 401.)
QDRANT_API_KEY=pakeisk-mane-rasymo-raktu
QDRANT_READ_KEY=pakeisk-mane-skaitymo-raktu

# Aliaso vardas. Versija yra KOLEKCIJA (`kb_v3`), aliasas visada `kb` — todėl perindeksavimas
# nereikalauja prastovos, o atstatymas yra viena operacija.
KB_COLLECTION=kb

# Kuri saugykla atsako į žinių paiešką: `files` (numatyta) arba `qdrant`.
# Perjungiama SĄMONINGAI. Neatsakius Qdrant, agentas nusileidžia į failus ir dirba toliau.
KB_BACKEND=files

# Kiek sekundžių laukti Qdrant atsakymo. Balso ėjime ilgai laukti negalima.
QDRANT_TIMEOUT=3
